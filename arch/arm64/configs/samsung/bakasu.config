# [Miku-Picked UI] BakaSU (KernelSU) + SUSFS.
#
# Merged on top of the device defconfig only when the ROM is built with
# WITH_BAKASU=true (see device/samsung/universal2100-common/BoardConfigCommon.mk).
# Without it this fragment is never applied and the kernel is stock.
#
# Hook mode is CONFIG_KSU_SUSFS ("SUSFS Inline Hook" in BakaSU's hook-method
# choice): o1s is a non-GKI 5.4 kernel, so the tracepoint hook (GKI2/5.10+ only)
# is unavailable, and the SUSFS kernel side is already integrated in-tree
# (fs/susfs.c + the ksu_handle_* source hooks), which is exactly what BakaSU's
# inline_hook_check.mk expects for this mode.

CONFIG_KSU=y

# SUSFS inline-hook mode + the susfs feature set (simonpunk/susfs4ksu).
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
